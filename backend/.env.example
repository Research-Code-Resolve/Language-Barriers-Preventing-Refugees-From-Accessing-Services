# Copy this file to .env and fill in the values you need.

# Port the API listens on.
PORT=8787

# Which LLM provider to use for answer generation:
#   huggingface | ollama | openai | none
# "huggingface" -> open-source model hosted in the cloud (no local hardware).
#                  Recommended for resource-limited deployments. Needs HF_TOKEN.
# "ollama"      -> same class of open-source model, running LOCALLY (offline,
#                  no key, but needs a capable machine).
# "none" (or a failed provider) runs in EXTRACTIVE mode: returns the best-
#                  matching knowledge-base answer verbatim, no generation.
LLM_PROVIDER=huggingface

# Model id for the chosen provider (examples):
#   huggingface -> meta-llama/Llama-3.1-8B-Instruct  (must be served by a provider
#                  enabled on your HF account; some models return 400 otherwise)
#   ollama      -> qwen2.5 | llama3.1 | mistral   (pull first: ollama pull qwen2.5)
#   openai      -> gpt-4o-mini
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Hugging Face (open-source, hosted) ---
# Get a token at https://huggingface.co/settings/tokens (a fresh one — the old
# token that was committed to this repo must be revoked). NEVER commit real keys.
HF_TOKEN=
# HF_BASE_URL=https://router.huggingface.co/v1

# --- Ollama (open-source, local) ---
OLLAMA_URL=http://localhost:11434

# --- OpenAI-compatible API (optional) ---
OPENAI_API_KEY=
# Point the "openai" provider at any OpenAI-compatible endpoint (Groq, Together,
# self-hosted vLLM). Leave blank for real OpenAI.
OPENAI_BASE_URL=

# Path to the knowledge-base CSV (defaults to ../knowledge_base/refugee_knowledge_base.csv).
# KB_PATH=../knowledge_base/refugee_knowledge_base.csv
