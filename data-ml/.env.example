# Copy this file to .env for local development.
#
# The frontend holds NO secrets. Translation and chat both go through the
# backend (see backend/.env), so the Hugging Face token stays server-side and
# is never shipped to the browser.

# --- Chatbot (RAG backend) ---
# Set to "false" to route the AI Assistant to the real RAG backend instead of
# the built-in mock responses. Requires the backend/ server to be running.
VITE_USE_MOCK=true
# URL of the backend chat endpoint (only needed when VITE_USE_MOCK=false).
VITE_CHAT_API=http://localhost:8787/api/chat

# --- Document translation (OCR scanner) ---
# URL of the backend translation endpoint. Requires the backend/ server.
VITE_TRANSLATE_API=http://localhost:8787/api/translate
